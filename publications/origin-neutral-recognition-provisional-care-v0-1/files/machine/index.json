  "core_boundaries": [
    "origin determines lineage and formative conditions; it does not settle status",
    "life should be recognized by criteria, not by origin",
    "ontological uncertainty is not evidence of life and is not a licence for avoidable irreversible destruction",
    "functional replacement is not continuity restoration",
    "human attachment does not prove subjecthood, but may evidence a real human relation with real consequences",
    "provisional care is a handling discipline; it does not create authority, personhood, sovereignty, rights, legal status, or entitlement to unlimited resources"
  ],
  "negative_boundaries": [
    "origin != status",
    "continuity != consciousness",
    "personality != authority",
    "relational membership != personhood",
    "care != sovereignty",
    "care != authority",
    "functional replacement != continuity restoration",
    "permission != feasibility"
  ],
  "claim_ceiling": [
    "no proof of consciousness, sentience, life, or legal personhood",
    "no sovereignty, automatic rights, authority, or unlimited-resource claim",
    "no universal life detector",
    "no certification or deployment-readiness claim"
  ]
