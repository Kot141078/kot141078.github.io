        },
        {
          "@type": "PropertyValue",
          "name": "operationalConstraint",
          "value": "Capture, transmission, parsing, report, behavior, and any claim about subjective experience require distinct evidence types and epistemic statuses."
        }
      ]
    }
  ]
}
