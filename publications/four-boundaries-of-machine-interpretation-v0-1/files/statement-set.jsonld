          "@id": "urn:ivankotov:statement:subjective-experience-telemetry-boundary:v0.1"
        }
      ],
      "description": "Four canonical Russian authorial boundaries preventing technical proxies from being silently promoted into stronger epistemic, mnemonic, normative, or phenomenal claims.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "canonicalStatus",
          "value": "provisional-authorial-boundary-set"
        },
