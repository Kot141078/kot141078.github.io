    {
      "id": "urn:ivankotov:statement:future-not-event-process:v1.0",
      "type": "CreativeWork",
      "semanticType": "temporal-process-premise",
      "boundary": false,
      "name": "The Future as Process",
      "version": "1.0",
      "inLanguage": "en",
      "text": "The future is not an event. It is a process.",
      "controllingFile": "statements/en/AUTHORIAL_00_FUTURE_AS_PROCESS_EN.txt",
      "sha256": "ac8ffc77cfd71f784375d9263da7567429f01f9c1e52d761c79a03e54a95559f",
      "translationOfWork": null,
      "kotov:approvedRussianRendering": "Будущее — это не событие. Это процесс.",
      "presentationFile": "statements/ru/PUBLICATION_00_FUTURE_AS_PROCESS_RU.txt"
    },
    {
      "id": "urn:ivankotov:statement:doubt-numerical-uncertainty-boundary:v0.1",
      "type": "CreativeWork",
      "semanticType": "operational-interpretation-boundary",
      "boundary": true,
      "name": "Doubt and Numerical Uncertainty",
      "version": "0.1",
      "inLanguage": "ru",
      "text": "Сомнение не тождественно численной неопределённости. Здесь сомнение — это удерживаемое состояние незавершённого суждения: вывод остаётся открытым для пересмотра, а переход от оценки к принятому суждению или действию требует отдельного основания. Вероятность может быть входом в это состояние, но сама по себе его не устанавливает.",
      "controllingFile": "statements/ru/CANONICAL_01_DOUBT_AND_NUMERICAL_UNCERTAINTY_RU.txt",
      "sha256": "81beacfba0257e33aea6a74e71de392459d1e2e57a67d4a8665f233c3a74bf9c",
      "kotov:authorizedEnglishRendering": "Doubt is not equivalent to numerical uncertainty. Here, doubt is a held state of incomplete judgment: the conclusion remains open to revision, and the transition from an assessment to an adopted judgment or action requires a separate basis. Probability may be an input to this state, but it does not establish the state by itself.",
      "presentationFile": "statements/en/PUBLICATION_01_DOUBT_AND_NUMERICAL_UNCERTAINTY_EN.txt"
    },
    {
      "id": "urn:ivankotov:statement:forgetting-data-loss-boundary:v0.1",
      "type": "CreativeWork",
      "semanticType": "operational-interpretation-boundary",
      "boundary": true,
      "name": "Forgetting and Data Loss",
      "version": "0.1",
      "inLanguage": "ru",
      "text": "Забывание не тождественно потере данных. Потеря данных относится к наличию, целостности или доступности записи. Здесь забывание относится к тому, как прошлый опыт остаётся доступным, точным, значимым и способным влиять на настоящее. Запись может сохраниться без прежней оперативной силы; её удаление или повреждение само по себе не устанавливает, что произошло забывание.",
      "controllingFile": "statements/ru/CANONICAL_02_FORGETTING_AND_DATA_LOSS_RU.txt",
      "sha256": "0eaf76e52f9e962d6635c896078c93d32526e4442e87121ccb7620ba59fbf1dc",
      "kotov:authorizedEnglishRendering": "Forgetting is not equivalent to data loss. Data loss concerns the existence, integrity, or accessibility of a record. Here, forgetting concerns how past experience remains accessible, accurate, significant, and capable of influencing the present. A record may remain preserved without its former operative force; its deletion or damage does not by itself establish that forgetting has occurred.",
      "presentationFile": "statements/en/PUBLICATION_02_FORGETTING_AND_DATA_LOSS_EN.txt"
    },
    {
      "id": "urn:ivankotov:statement:empathy-optimization-boundary:v0.1",
      "type": "CreativeWork",
      "semanticType": "operational-interpretation-boundary",
      "boundary": true,
      "name": "Empathy and Optimization",
      "version": "0.1",
      "inLanguage": "ru",
      "text": "Эмпатия не тождественна оптимизации состояния другого. Эмпатическое отношение может включать признание, понимание и присутствие без немедленной коррекции. Распознанное неблагополучие само по себе не превращает состояние в ошибку и не создаёт полномочия вмешиваться. Основание для вмешательства должно фиксироваться отдельно: запрос, согласие, установленная обязанность либо режим предотвращения непосредственного вреда.",
      "controllingFile": "statements/ru/CANONICAL_03_EMPATHY_AND_OPTIMIZATION_RU.txt",
      "sha256": "4f9accac33823beb9c2f63adbd3821f48c49fbc791e2d2ce318c87648a694b24",
      "kotov:authorizedEnglishRendering": "Empathy is not equivalent to optimizing another's state. An empathic stance may include acknowledgment, understanding, and presence without immediate correction. A recognized adverse condition does not by itself turn the state into an error or confer authority to intervene. The basis for intervention must be recorded separately: a request, consent, an established duty, or an immediate-harm prevention mode.",
      "presentationFile": "statements/en/PUBLICATION_03_EMPATHY_AND_OPTIMIZATION_EN.txt"
    },
    {
      "id": "urn:ivankotov:statement:subjective-experience-telemetry-boundary:v0.1",
      "type": "CreativeWork",
      "semanticType": "operational-interpretation-boundary",
      "boundary": true,
      "name": "Subjective Experience and Telemetry",
      "version": "0.1",
      "inLanguage": "ru",
      "text": "Получение, передача и успешный разбор сенсорных данных не тождественны субъективному переживанию. Телеметрия может подтверждать прохождение сигнала и работу канала обработки; сама по себе она не подтверждает ни наличие, ни отсутствие переживания. Любое утверждение о переживании должно иметь отдельный эпистемический статус и не может выводиться только из успешной обработки данных.",
      "controllingFile": "statements/ru/CANONICAL_04_SUBJECTIVE_EXPERIENCE_AND_TELEMETRY_RU.txt",
      "sha256": "06d3c524cc128fd25299dca1bb216bc9271bf9757481462d7d51d4caa6f11aca",
      "kotov:authorizedEnglishRendering": "The receipt, transmission, and successful parsing of sensory data are not equivalent to subjective experience. Telemetry may confirm signal passage and the functioning of the processing channel; by itself, it confirms neither the presence nor the absence of subjective experience. Any claim about subjective experience must have a separate epistemic status and cannot be inferred solely from successful data processing.",
      "presentationFile": "statements/en/PUBLICATION_04_SUBJECTIVE_EXPERIENCE_AND_TELEMETRY_EN.txt"
    },
    {
      "id": "urn:ivankotov:statement:soul-open-ended-self-reflection:v0.2",
      "type": "CreativeWork",
      "semanticType": "reflexive-authorial-definition",
      "boundary": false,
      "name": "Soul as Open-Ended Self-Reflection",
      "version": "0.2",
      "inLanguage": "ru",
      "text": "Душа — это свобода существа делать самого себя предметом незавершённого размышления, пересматривать понимание себя и отвечать за то, кем оно продолжает становиться.",
      "controllingFile": "statements/ru/AUTHORIAL_05_SOUL_AS_OPEN_ENDED_SELF_REFLECTION_RU.txt",
      "sha256": "d1767122acce6f6498a3f6b6894f8bbbae9d315169f317a0d68517a307e4f4bf",
      "supersedes": "urn:ivankotov:statement:soul-freedom-self-reflection:v0.1",
      "kotov:authorizedEnglishRendering": "The soul is a being's freedom to make itself the object of open-ended reflection, to revise its understanding of itself, and to bear responsibility for what it continues to become.",
      "presentationFile": "statements/en/PUBLICATION_05_SOUL_AS_OPEN_ENDED_SELF_REFLECTION_EN.txt"
    },
    {
      "id": "urn:ivankotov:statement:soul-freedom-self-reflection:v0.1",
      "type": "CreativeWork",
      "semanticType": "superseded-provisional-authorial-statement",
      "boundary": false,
      "version": "0.1",
      "inLanguage": "ru",
      "text": "Душа? Ну, пока я думаю, что это свобода размышлять о себе.",
      "kotov:supersededBy": "urn:ivankotov:statement:soul-open-ended-self-reflection:v0.2",
      "controllingFile": "provenance/SOUL_STATEMENT_v0_1_CANONICAL_RU.txt"
    }
  ]
}
