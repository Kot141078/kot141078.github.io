{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivankotov.eu/schemas/term-registry-v1.schema.json",
  "title": "Ivan Kotov public term registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_id", "url", "last_verified", "preferred_label_rule", "claim_boundary", "source_hashes", "term_count", "terms", "distinction_count", "distinctions"],
  "properties": {
    "$schema": {"const": "https://ivankotov.eu/schemas/term-registry-v1.schema.json"},
    "schema_version": {"const": "term-registry.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "last_verified": {"type": "string", "format": "date"},
    "preferred_label_rule": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_map", "core_terms", "distinctions"],
      "properties": {
        "canonical_map": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "core_terms": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "distinctions": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "term_count": {"type": "integer", "minimum": 1},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "local_id", "preferred_label", "alternate_labels", "long_form", "definition", "scope", "authoritative_source", "source_version", "status", "non_equivalents", "related_terms", "language"],
        "properties": {
          "term_id": {"type": "string", "format": "uri"},
          "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "preferred_label": {"type": "string", "minLength": 1},
          "alternate_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "long_form": {"type": ["string", "null"]},
          "definition": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "authoritative_source": {"type": "string", "format": "uri"},
          "source_version": {"type": ["string", "null"]},
          "status": {"type": "string", "minLength": 1},
          "non_equivalents": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "related_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "language": {"type": "string", "minLength": 2}
        }
      }
    },
    "distinction_count": {"type": "integer", "minimum": 1},
    "distinctions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "term", "non_equivalent_to", "reason", "authoritative_source"],
        "properties": {
          "boundary_id": {"type": "string", "minLength": 1},
          "term": {"type": "string", "minLength": 1},
          "non_equivalent_to": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "authoritative_source": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
