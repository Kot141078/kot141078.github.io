{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivankotov.eu/schemas/scientific-corpus-index-v1.schema.json",
  "title": "Ivan Kotov normalized public authored corpus index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_id", "url", "last_verified", "author", "scope", "authority_rule", "claim_boundary", "source", "work_count", "works"],
  "properties": {
    "$schema": {"const": "https://ivankotov.eu/schemas/scientific-corpus-index-v1.schema.json"},
    "schema_version": {"const": "scientific-corpus-index.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "last_verified": {"type": "string", "format": "date"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orcid", "profile"],
      "properties": {
        "name": {"const": "Ivan Kotov"},
        "orcid": {"const": "https://orcid.org/0009-0009-6002-9845"},
        "profile": {"type": "string", "format": "uri"}
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "authority_rule": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "record_count"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 1}
      }
    },
    "work_count": {"type": "integer", "minimum": 1},
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/work"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableUri": {"type": ["string", "null"], "format": "uri"},
    "sha256OrNull": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "@id", "schema_org_type", "source_type", "title", "alternative_title", "role", "summary", "primary_url", "version", "date", "status", "languages", "source_language_labels", "identifiers", "source", "licenses", "integrity", "claim_boundary", "metadata_completeness", "legacy_source_pointer"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "@id": {"type": "string", "format": "uri"},
        "schema_org_type": {"enum": ["Book", "CreativeWork", "ScholarlyArticle", "SoftwareSourceCode"]},
        "source_type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "alternative_title": {"$ref": "#/$defs/nullableString"},
        "role": {"type": "string", "minLength": 1},
        "summary": {"$ref": "#/$defs/nullableString"},
        "primary_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "version": {"$ref": "#/$defs/nullableString"},
        "date": {"$ref": "#/$defs/nullableString"},
        "status": {"$ref": "#/$defs/nullableString"},
        "languages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "source_language_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version_doi", "concept_doi", "other"],
          "properties": {
            "version_doi": {"$ref": "#/$defs/nullableUri"},
            "concept_doi": {"$ref": "#/$defs/nullableUri"},
            "other": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_url", "repository_detail_url", "repository_path", "release_url", "release_tag", "commit"],
          "properties": {
            "repository_url": {"$ref": "#/$defs/nullableUri"},
            "repository_detail_url": {"$ref": "#/$defs/nullableUri"},
            "repository_path": {"$ref": "#/$defs/nullableString"},
            "release_url": {"$ref": "#/$defs/nullableUri"},
            "release_tag": {"$ref": "#/$defs/nullableString"},
            "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$"}
          }
        },
        "licenses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall", "software", "documentation", "machine_metadata", "rights"],
          "properties": {
            "overall": {"$ref": "#/$defs/nullableString"},
            "software": {"$ref": "#/$defs/nullableString"},
            "documentation": {"$ref": "#/$defs/nullableString"},
            "machine_metadata": {"$ref": "#/$defs/nullableString"},
            "rights": {"$ref": "#/$defs/nullableString"}
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "archive_sha256", "manifest_url", "checksums_url"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256OrNull"},
            "archive_sha256": {"$ref": "#/$defs/sha256OrNull"},
            "manifest_url": {"$ref": "#/$defs/nullableUri"},
            "checksums_url": {"$ref": "#/$defs/nullableUri"}
          }
        },
        "claim_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["non_claims", "source_field", "rule"],
          "properties": {
            "non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "source_field": {"type": ["string", "null"], "enum": ["non_claims", "not", null]},
            "rule": {"type": "string", "minLength": 1}
          }
        },
        "metadata_completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known", "unknown"],
          "properties": {
            "known": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "unknown": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "legacy_source_pointer": {"type": "string", "pattern": "^/works-index\\.json#/works/\\d+$"}
      }
    }
  }
}
