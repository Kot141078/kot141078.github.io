{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivankotov.eu/schemas/semantic-bridges-v1.schema.json",
  "title": "Ivan Kotov public semantic bridge overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_id", "url", "last_verified", "status", "claim_boundary", "source_sha256", "relation_definitions", "bridge_count", "bridges"],
  "properties": {
    "$schema": {"const": "https://ivankotov.eu/schemas/semantic-bridges-v1.schema.json"},
    "schema_version": {"const": "semantic-bridges.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "last_verified": {"type": "string", "format": "date"},
    "status": {"const": "interpretive-machine-routing-overlay"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relation_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "relation_uri", "definition"],
        "properties": {
          "relation": {"type": "string", "minLength": 1},
          "relation_uri": {"type": "string", "format": "uri"},
          "definition": {"type": "string", "minLength": 1}
        }
      }
    },
    "bridge_count": {"type": "integer", "minimum": 3},
    "bridges": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bridge_id", "visibility", "title", "scope", "nodes", "edges", "canonical_evidence", "claim_ceiling"],
        "properties": {
          "bridge_id": {"type": "string", "pattern": "^BRIDGE-(?:MOT-C-)?(?:IMPLICIT-)?\\d{3}$"},
          "visibility": {"enum": ["explicit", "implicit"]},
          "title": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "url"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri"}
              }
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "relation", "target", "relation_uri"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "relation": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1},
                "relation_uri": {"type": "string", "format": "uri"}
              }
            }
          },
          "canonical_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
          "claim_ceiling": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
