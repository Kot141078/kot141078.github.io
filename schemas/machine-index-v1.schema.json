{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivankotov.eu/schemas/machine-index-v1.schema.json",
  "title": "Ivan Kotov public machine entry index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_id", "url", "last_verified", "human_entry", "author", "scope", "authority_rule", "claim_boundary", "counts", "entries"],
  "properties": {
    "$schema": {"const": "https://ivankotov.eu/schemas/machine-index-v1.schema.json"},
    "schema_version": {"const": "machine-index.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https://ivankotov\\.eu/"},
    "last_verified": {"type": "string", "format": "date"},
    "human_entry": {"type": "string", "format": "uri"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orcid"],
      "properties": {
        "name": {"const": "Ivan Kotov"},
        "orcid": {"const": "https://orcid.org/0009-0009-6002-9845"}
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "authority_rule": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_works", "terms", "distinctions", "semantic_bridges", "public_repositories"],
      "properties": {
        "normalized_works": {"type": "integer", "minimum": 1},
        "terms": {"type": "integer", "minimum": 1},
        "distinctions": {"type": "integer", "minimum": 1},
        "semantic_bridges": {"type": "integer", "minimum": 3},
        "public_repositories": {"type": "integer", "minimum": 1}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "url", "media_type", "schema"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "media_type": {"type": "string", "minLength": 1},
          "schema": {"type": ["string", "null"], "format": "uri"}
        }
      }
    }
  }
}
