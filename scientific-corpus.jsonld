      "item": {
        "@type": "CreativeWork",
        "@id": "https://ivankotov.eu/id/work/boundaries-of-machine-interpretation-v0-2",
        "name": "Boundaries of Machine Interpretation",
        "url": "https://ivankotov.eu/publications/boundaries-of-machine-interpretation/",
        "creator": {
          "@id": "https://ivankotov.eu/about/#person"
        },
        "version": "0.2",
        "datePublished": "2026-08-07",
        "description": "A bilingual, machine-readable publication preventing technical proxies from being silently promoted into stronger epistemic, relational, normative, or phenomenal statuses. It contains six typed units, but only four are operational interpretation boundaries.",
