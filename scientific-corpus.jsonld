    {
      "@type": "ListItem",
      "position": 6,
      "item": {
        "@type": "CreativeWork",
        "@id": "https://ivankotov.eu/id/work/four-boundaries-of-machine-interpretation-v0-1",
        "name": "Four Boundaries of Machine Interpretation: Canonical Authorial Statement Set",
        "url": "https://ivankotov.eu/publications/four-boundaries-of-machine-interpretation-v0-1/",
        "creator": {
          "@id": "https://ivankotov.eu/about/#person"
        },
        "version": "0.1",
        "datePublished": "2026-08-07",
        "description": "Four separately hashed canonical Russian authorial boundaries separating doubt from numerical uncertainty, forgetting from data loss, empathy from optimization, and subjective experience from telemetry. The set records prohibited automatic inferences without claiming that machines either possess or lack those states."
      }
    },
    {
      "@type": "ListItem",
