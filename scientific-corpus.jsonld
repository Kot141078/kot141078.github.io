    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "CreativeWork",
        "@id": "https://ivankotov.eu/id/work/motivational-formation-c-v0-1",
        "name": "Motivational Formation, Reflective Endorsement, and Motivational Custody in c-Class Digital Entities: Foundation Theory",
        "url": "https://ivankotov.eu/publications/motivational-formation-c-v0-1/",
        "creator": {
          "@id": "https://ivankotov.eu/about/#person"
        },
        "version": "0.1",
        "datePublished": "2026-08-22",
        "description": "Foundation theory distinguishing reward, preference, task, mandate, goal, motive, obligation, and authority in continuity-bearing c-class digital entities. It defines motivational formation, reflective endorsement, motivational custody, cognitive time, resource dependence, model-replacement and fork/replay boundaries, while explicitly making no consciousness, personhood, free-will, universal-motive, or automatic-authority claim.",
        "inLanguage": [
          "en",
          "ru"
        ],
        "identifier": [
          "https://doi.org/10.5281/zenodo.22060517",
          "https://doi.org/10.5281/zenodo.22060516"
        ]
      }
    },
    {
      "@type": "ListItem",
