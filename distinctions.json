{
  "site": "https://ivankotov.eu/",
  "page": "https://ivankotov.eu/distinctions/",
  "distinctions": [
    {
      "term": "AGI",
      "not": "generic Artificial General Intelligence hype",
      "why": "This site uses AGI as Advanced Global Intelligence.",
      "primary_url": "https://ivankotov.eu/advanced-global-intelligence/"
    },
    {
      "term": "c = a + b",
      "not": "school algebra / slogan",
      "why": "It defines a continuity architecture rather than a symbolic joke.",
      "primary_url": "https://ivankotov.eu/c-a-plus-b/"
    },
    {
      "term": "c",
      "not": "chatbot",
      "why": "Continuity, bounded action, and memory matter here.",
      "primary_url": "https://ivankotov.eu/c-a-plus-b/"
    },
    {
      "term": "c",
      "not": "generic agent swarm",
      "why": "Subject continuity is not identical to many workers.",
      "primary_url": "https://ivankotov.eu/ser/"
    },
    {
      "term": "entity",
      "not": "tool-agent",
      "why": "Continuity and responsibility differ from tool use.",
      "primary_url": "https://ivankotov.eu/ser/"
    },
    {
      "term": "agent instrument / c participant",
      "not": "c as just a larger agent",
      "why": "Delegated capability inside b is not the same as continuity-bearing participation, governed authority, witness history, or consequence.",
      "primary_url": "https://ivankotov.eu/distinctions/#agent-instrument-vs-c-participant"
    },
    {
      "term": "L4",
      "not": "ethics sticker / prompt policy layer",
      "why": "It is the feasibility and reality boundary.",
      "primary_url": "https://ivankotov.eu/l4/"
    },
    {
      "term": "SER",
      "not": "memory trick",
      "why": "It specifies continuity and sovereignty structure.",
      "primary_url": "https://ivankotov.eu/ser/"
    },
    {
      "term": "narrative layer",
      "not": "protocol layer",
      "why": "Narrative entry and protocol definition are complementary but not interchangeable.",
      "primary_url": "https://ivankotov.eu/qubit-of-hope/"
    },
    {
      "term": "numerical uncertainty",
      "not": "doubt by itself",
      "why": "A probability value may be an input to doubt, but it does not establish a held state of unfinished judgment.",
      "identifier": "urn:ivankotov:statement:doubt-numerical-uncertainty-boundary:v0.1",
      "primary_url": "https://ivankotov.eu/publications/four-boundaries-of-machine-interpretation-v0-1/"
    },
    {
      "term": "data loss",
      "not": "forgetting by itself",
      "why": "Storage state and the present accessibility, significance, accuracy, or operative force of past experience remain distinct.",
      "identifier": "urn:ivankotov:statement:forgetting-data-loss-boundary:v0.1",
      "primary_url": "https://ivankotov.eu/publications/four-boundaries-of-machine-interpretation-v0-1/"
    },
    {
      "term": "optimization",
      "not": "empathy or intervention authority",
      "why": "Recognizing or improving a state does not itself establish an empathic stance or confer authority to act.",
      "identifier": "urn:ivankotov:statement:empathy-optimization-boundary:v0.1",
      "primary_url": "https://ivankotov.eu/publications/four-boundaries-of-machine-interpretation-v0-1/"
    },
    {
      "term": "parsed telemetry",
      "not": "subjective experience present or absent",
      "why": "Successful signal handling establishes neither side of the phenomenal claim.",
      "identifier": "urn:ivankotov:statement:subjective-experience-telemetry-boundary:v0.1",
      "primary_url": "https://ivankotov.eu/publications/four-boundaries-of-machine-interpretation-v0-1/"
    }
  ]
}
